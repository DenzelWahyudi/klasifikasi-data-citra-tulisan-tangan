# Konfigurasi Host dan Port Server Backend
# Catatan: Platform cloud seperti Render, Railway, Fly.io biasanya menyuntikkan PORT secara otomatis
HOST=0.0.0.0
PORT=8000

# Path direktori model (default otomatis mencari di model_export jika tidak disetel)
MODEL_EXPORT_DIR=model_export

# Domain frontend yang diizinkan untuk CORS (pisahkan dengan koma jika lebih dari satu, atau gunakan * untuk semua domain)
# Contoh produksi: https://foren-ai.vercel.app,http://localhost:5173
CORS_ORIGINS=*
